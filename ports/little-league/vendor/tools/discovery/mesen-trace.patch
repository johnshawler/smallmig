+		TraceRec('W', addr, value, -1, _console->GetCpu()->GetCycleCount(), _console->GetPpu()->GetFrameCount());
+	}
 	_ramWriteHandlers[addr]->WriteRAM(addr, value);
 	_openBusHandler.SetOpenBus(value);
