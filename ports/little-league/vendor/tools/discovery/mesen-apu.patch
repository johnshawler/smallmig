@@ -192,6 +195,11 @@ void APU::Exec()
 void APU::EndFrame()
 {
 	Run();
+	if(g_apuLog) {
+		//block end marker (ch 255): EndFrame is called every CycleLength-1 cycles AND at the end of every video frame (Console::RunFrame)
+		struct { uint32_t cc; uint8_t ch; uint8_t lvl; uint16_t stamp; } r = { (uint32_t)(_console->GetCpu()->GetCycleCount() - _currentCycle + _currentCycle), 255, 0, (uint16_t)_currentCycle };
+		fwrite(&r, sizeof(r), 1, g_apuLog);
+	}
 	_squareChannel[0]->EndFrame();
 	_squareChannel[1]->EndFrame();
 	_triangleChannel->EndFrame();
