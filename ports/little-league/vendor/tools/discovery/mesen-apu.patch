 class BaseApuChannel : public IMemoryHandler, public Snapshotable
 {
@@ -97,6 +101,11 @@ public:
 	void AddOutput(int8_t output)
 	{
 		if(output != _lastOutput) {
+			if(g_apuLog) {
+				//APU event log: bus cycle (CPU cycle count numbering), channel, new level
+				struct { uint32_t cc; uint8_t ch; uint8_t lvl; uint16_t stamp; } r = { (uint32_t)(_console->GetCpu()->GetCycleCount() - _console->GetApu()->GetApuCurrentCycle() + _previousCycle), (uint8_t)_channel, (uint8_t)output, (uint16_t)_previousCycle /*block coordinate, i.e. the blip timestamp*/ };
+				fwrite(&r, sizeof(r), 1, g_apuLog);
+			}
 			_mixer->AddDelta(_channel, _previousCycle, output - _lastOutput);
 			_lastOutput = output;
 		}
